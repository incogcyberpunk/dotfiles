# ============================================================================
# keys_user.config - personal sioyek keybindings
# Base keybindings live in /etc/sioyek/keys.config (or run `keys` inside
# sioyek). Anything set here overrides/adds to those.
#
# TWO RULES THIS FILE HAS TO RESPECT, both learned the hard way (sioyek prints
# the violations to stdout on startup -- run `sioyek --verbose` to check):
#
# 1. PREFIX RULE: if one sequence is a strict prefix of another, sioyek
#    silently UNMAPS the shorter one. `hd` killed `h`, `dcp` killed `dc`,
#    `dh0` killed `dh`. Sequences may be siblings (`dc` / `dC`) but never
#    parent/child.
# 2. SHIFT SYNTAX: `<C-S-x>` is no longer valid. Ctrl+Shift+X is `<C-X>`
#    (capitalise the letter). Same for Alt: `<A-N>` is Alt+Shift+N.
#
# Plus one external rule: Hyprland grabs `ALT+H`, `ALT+L`, `ALT+M`, `ALT+S`,
# `ALT+SPACE`, `ALT+TAB`, `ALT+V`, every `ALT+<digit>` and `CTRL+ALT+*`
# globally, so those never reach sioyek. ALT+S is suspend and ALT+L is the
# lockscreen -- do not bind them here. No function keys are used in this file.
#
# Free namespaces (nothing in sioyek's defaults starts with these):
#   a  -> annotation/highlight extras      w  -> window chrome toggles
#   plus e i u x y are still unclaimed if you need more.
# ============================================================================

# ---------- ZOOM ----------
zoom_in <C-=>
zoom_out <C-->

# ---------- PAGE NAVIGATION ----------
next_page <C-d>
previous_page <C-u>

goto_page_with_page_number gt

# Opens the selected text as a url in the default browser
open_selected_url gx

# ---------- HIGHLIGHTS (pdf.js-style colors) ----------
# `add_highlight` is bound to `h` by default and waits for one more keypress:
# the highlight-type letter. The letters are remapped in prefs_user.config to
# match pdf.js's palette, so select text and type:
#   hy = yellow   hg = green   hb = blue   hp = pink   hr = red
#   ho = orange (bonus)   hu = purple (bonus)
# Nothing is bound here for it on purpose: any h<x> binding would unmap `h`.
# delete_highlight stays on its default `dh`.

# Re-highlight the selection with whatever color you last used, no letter
# needed -- the pdf.js "remembers your last swatch" behaviour.
add_highlight_with_current_type <C-h>
# Pin which color that is, e.g. `<C-H>y` pins yellow. (Ctrl+Shift+H.)
set_select_highlight_type <C-H>
# Auto-highlight everything you select with the mouse, using the pinned color.
# Was <A-h>, which Hyprland steals for focus-left.
toggle_select_highlight ah

# Jump between highlights in the current document.
goto_next_highlight gnh
goto_prev_highlight gNh

# ---------- FREEHAND DRAWING (pdf.js pencil/ink tool equivalent) ----------
# Draw with the mouse, like pdf.js's "Draw" toolbar button.
toggle_freehand_drawing_mode D
# Draw with a stylus/tablet pen instead (mouse behaves normally).
toggle_pen_drawing_mode <C-D>

# Set drawing color, reusing the same letter palette as highlights, e.g.
# `dcr` = red pen, `dcy` = yellow pen, `dcb` = blue pen, etc.
set_freehand_type dc
# Set line thickness / opacity for the pen (each prompts for a value).
set_freehand_thickness dt
set_freehand_alpha da

# Undo the last drawing stroke (like Ctrl+Z in pdf.js's editor).
undo_drawing <C-z>

# Rubber-band select a region of drawings, then delete them.
select_freehand_drawings ds
delete_freehand_drawings dx

# Clear all drawings on the current page / entire document.
# Capitalised so they stay siblings of `dc` instead of children of it.
clear_current_page_drawings dC
clear_current_document_drawings dA

# Hide/show all drawings without deleting them (e.g. to compare before/after).
# Were dh0/dh1, which unmapped `dh` (delete_highlight).
turn_off_all_drawings d0
turn_on_all_drawings d1

# Scratchpad: a free-floating canvas for sketches not tied to the page.
toggle_scratchpad_mode <C-P>
copy_drawings_from_scratchpad dy

# ---------- COLOR MODES ----------
# Dark mode (color inversion). Was bare `d`, which the whole `d*` delete/draw
# namespace unmapped, so it never actually worked.
toggle_dark_mode <A-d>
# Reading-mode color scheme (sepia-like, distinct from dark mode inversion).
toggle_custom_color <A-r>
# Highlight PDF links. Default is <f1>; rebound to keep function keys free.
toggle_highlight wu

# ---------- QUALITY OF LIFE ----------
# Smooth, physics-based scrolling (toggle on/off).
toggle_smooth_scroll_mode <C-S>

# Regex search (requires super_fast_search enabled in prefs_user.config).
regex_search <C-F>

# ---------- CUSTOM COMMANDS ----------
# new_command / new_macro definitions live in prefs_user.config, not here --
# this file is parsed by the keybinding reader, which does not understand them.

# ---------- WINDOW CHROME (w = "window") ----------
# All four were on Alt before; ALT+S and ALT+L are Hyprland's suspend and
# lockscreen, so the whole group moved to the free `w` prefix.
toggle_statusbar ws
toggle_titlebar wt
toggle_scrollbar wb
# Lock horizontal scrolling (handy on touchpads so you don't drift sideways).
toggle_horizontal_scroll_lock wl

# ---------- LAYOUT & READING MODES ----------
# Two-page (spread) view, like a physical book. Was <A-2>, but Hyprland binds
# every ALT+<digit> to a workspace.
toggle_two_page_mode <A-t>
# Fit page to window height instead of width.
fit_to_page_height <A-w>

# ---------- TEXT-TO-SPEECH ----------
# Read the document aloud from the current position; toggle pauses/resumes.
toggle_reading <C-r>
stop_reading <C-R>

# ---------- OVERVIEW / SEARCH NAVIGATION ----------
# Preview next/previous search result in a small overview window instead of
# jumping there directly (handy for skimming matches quickly).
overview_next_item <A-n>
overview_prev_item <A-N>

# ---------- PORTABILITY ----------
# Bake highlights/bookmarks into a new PDF file so any other PDF reader can
# see them too (sioyek normally stores annotations in its own database).
embed_annotations <A-e>

# ---------- MISC ----------
# Fuzzy-searchable list of every command with its current keybinding --
# faster than digging through this file when you forget a shortcut.
command_palette <C-K>
# Jump to a random page (useful for flashcard-style review of long PDFs).
goto_random_page gr
