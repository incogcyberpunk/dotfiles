# ============================================================================
# keys_user.config - personal sioyek keybindings
# Base keybindings live in /etc/sioyek/keys.config (or run `keys` inside
# sioyek). Anything set here overrides/adds to those.
# ============================================================================

toggle_dark_mode d

# ---------- ZOOM ----------
zoom_in <C-=>
zoom_out <C-->

# ---------- PAGE NAVIGATION ----------
next_page <C-d>
previous_page <C-u>

goto_page_with_page_number gt

# Opens the selected text as a url in the default browser
open_selected_url gx

# ---------- HIGHLIGHTS (pdf.js-style colors) ----------
# `add_highlight` (bound to `h` by default) waits for one more keypress: the
# highlight-type letter. The letters below are remapped in prefs_user.config
# to match pdf.js's highlight colors, so just select text and type:
#   hy = yellow   hg = green   hb = blue   hp = pink   hr = red
#   ho = orange (bonus)   hu = purple (bonus)
# No extra binding needed here since `h` + letter already does this.
delete_highlight hd

# Quickly re-highlight selected text with whatever type you used last,
# without re-typing the letter.
add_highlight_with_current_type <C-h>
# Type a letter to set which color add_highlight_with_current_type/select
# highlight mode will use, e.g. `<C-S-h>y` sets current type to yellow.
set_select_highlight_type <C-S-h>
# Auto-highlight everything you select with the mouse (current type).
toggle_select_highlight <A-h>

# Jump between highlights in the current document.
goto_next_highlight gnh
goto_prev_highlight gNh

# ---------- FREEHAND DRAWING (pdf.js pencil/ink tool equivalent) ----------
# Draw with the mouse, like pdf.js's "Draw" toolbar button.
toggle_freehand_drawing_mode D
# Draw with a stylus/tablet pen instead (mouse behaves normally).
toggle_pen_drawing_mode <C-S-d>

# Set drawing color, reusing the same letter palette as highlights, e.g.
# `dcr` = red pen, `dcy` = yellow pen, `dcb` = blue pen, etc.
set_freehand_type dc
# Set line thickness / opacity for the pen (each prompts for a value).
set_freehand_thickness dt
set_freehand_alpha da

# Undo the last drawing stroke (like Ctrl+Z in pdf.js's editor).
undo_drawing <C-z>

# Rubber-band select a region of drawings, then delete them.
select_freehand_drawings ds
delete_freehand_drawings dx

# Clear all drawings on the current page / entire document.
clear_current_page_drawings dcp
clear_current_document_drawings dcD

# Hide/show all drawings without deleting them (e.g. to compare before/after).
turn_off_all_drawings dh0
turn_on_all_drawings dh1

# Scratchpad: a free-floating canvas for sketches not tied to the page.
toggle_scratchpad_mode <C-S-p>
copy_drawings_from_scratchpad dcs

# ---------- QUALITY OF LIFE ----------
# Smooth, physics-based scrolling (toggle on/off).
toggle_smooth_scroll_mode <C-S-s>

# Reading-mode color scheme (sepia-like, distinct from dark mode inversion).
toggle_custom_color <A-d>

# Regex search (requires super_fast_search enabled in prefs_user.config).
regex_search <C-S-f>

# Hide the statusbar / titlebar for a cleaner, more immersive reading view.
toggle_statusbar <A-s>
toggle_titlebar <A-t>

# ---------- CUSTOM COMMANDS ----------
new_command _add_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"
new_command _add_red_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}" fontsize=5 text_color=255,0,0

# ---------- LAYOUT & READING MODES ----------
# Two-page (spread) view, like a physical book.
toggle_two_page_mode <A-2>
# Fit page to window height instead of width.
fit_to_page_height <A-w>
# Lock horizontal scrolling (handy on touchpads so you don't drift sideways).
toggle_horizontal_scroll_lock <A-l>
# Show/hide the scrollbar.
toggle_scrollbar <A-b>

# ---------- TEXT-TO-SPEECH ----------
# Read the document aloud from the current position; toggle pauses/resumes.
toggle_reading <C-r>
stop_reading <C-S-r>

# ---------- OVERVIEW / SEARCH NAVIGATION ----------
# Preview next/previous search result in a small overview window instead of
# jumping there directly (handy for skimming matches quickly).
overview_next_item <A-n>
overview_prev_item <A-N>

# ---------- PORTABILITY ----------
# Bake highlights/bookmarks into a new PDF file so any other PDF reader can
# see them too (sioyek normally stores annotations in its own database).
embed_annotations <A-e>

# ---------- MISC ----------
# Fuzzy-searchable list of every command with its current keybinding —
# faster than digging through this file when you forget a shortcut.
command_palette <C-S-k>
# Jump to a random page (useful for flashcard-style review of long PDFs).
goto_random_page gr
