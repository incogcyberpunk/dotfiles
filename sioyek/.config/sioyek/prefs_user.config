# ============================================================================
# prefs_user.config - personal sioyek preferences
# Overrides values from the shipped /etc/sioyek/prefs.config (see that file,
# or the `prefs` command inside sioyek, for the full list of defaults).
# ============================================================================

# ---------- STARTUP ----------
# Launch in dark mode and keep using the current window rather than spawning
# a new one every time a file is opened.
startup_commands toggle_dark_mode
should_launch_new_window 1
should_load_tutorial_when_no_other_file 1

# ---------- APPEARANCE ----------
page_separator_width 1
page_separator_color 0.5 0.5 0.5

# Dim pure white text in dark mode so it's easier on the eyes.
dark_mode_contrast 0.85

# Text box (add_freetext_bookmark, `B`) font size. Default is 8, far too small;
# 18 = 2.25x. Only affects new boxes -- each box stores its own size.
freetext_bookmark_font_size 18

# Mouse-selection highlight color while dragging (pdf.js default yellow).
text_highlight_color 1.0 1.0 0.596

# ---------- HIGHLIGHT COLORS (pdf.js palette) ----------
# pdf.js's built-in highlight editor ships 5 swatches (see mozilla/pdf.js
# web/app_options.js -> highlightEditorColors): yellow, green, blue, pink, red.
# We remap those letters here and add two bonus colors (orange, purple) since
# sioyek supports 26 highlight types (a-z). Use with `add_highlight` + letter,
# see keys_user.config for the actual keybindings.
#
# NOTE: the highlight shader draws at a HARDCODED 0.3 opacity (compiled into
# the binary, no config knob). At 0.3 a pale color barely shows, so these are
# the saturated/pure versions of the pdf.js swatches rather than the pastel
# originals -- brightness is the only lever we have without recompiling.
# The pastel pdf.js values are kept in the trailing comment on each line.

# Yellow  (pure; pdf.js pastel was 1.00 1.00 0.596)
highlight_color_y 1.00 1.00 0.00
# Green   (pure; pdf.js pastel was 0.325 1.00 0.737)
highlight_color_g 0.00 1.00 0.40
# Blue    (pure; pdf.js pastel was 0.502 0.922 1.00)
highlight_color_b 0.00 0.75 1.00
# Pink    (saturated; pdf.js pastel was 1.00 0.796 0.902)
highlight_color_p 1.00 0.40 0.70
# Red     (saturated; pdf.js pastel was 1.00 0.310 0.373)
highlight_color_r 1.00 0.10 0.15
# Orange  (saturated; bonus, not in pdf.js default set)
highlight_color_o 1.00 0.50 0.00
# Purple  (saturated; bonus)
highlight_color_u 0.60 0.20 1.00

# Freehand drawings reuse the highlight_color_* palette (set_freehand_type
# picks one of these by letter, same as highlight types). Default pen color:
highlight_color_a 1.00 0.10 0.15

# ---------- SWATCH PALETTE ON SELECTION (pdf.js-style) ----------
# pdf.js pops a row of swatches when you select text. Sioyek's equivalent is a
# right-click context menu, off by default; turn it on:
right_click_context_menu 1

# One macro per swatch. Each does TWO things, which is what makes it behave
# like pdf.js: set_select_highlight_type pins the color as "current", then
# add_highlight applies it. After that, <C-H> (add_highlight_with_current_type)
# and `ah` (toggle_select_highlight) reuse that same color -- exactly like
# pdf.js remembering your last-picked swatch.
# The macro name is what shows up as the menu label. It must be a single token
# starting with '_', and sioyek's macro parser only accepts letters, digits,
# '_', '$', '[' and ']' in command names -- so no spaces and no emoji swatches.
new_macro _Yellow set_select_highlight_type(y);add_highlight(y)
new_macro _Green set_select_highlight_type(g);add_highlight(g)
new_macro _Blue set_select_highlight_type(b);add_highlight(b)
new_macro _Pink set_select_highlight_type(p);add_highlight(p)
new_macro _Red set_select_highlight_type(r);add_highlight(r)
new_macro _Orange set_select_highlight_type(o);add_highlight(o)
new_macro _Purple set_select_highlight_type(u);add_highlight(u)

# Right-click ON selected text -> palette.
context_menu_items_for_selected_text _Yellow|_Green|_Blue|_Pink|_Red|_Orange|_Purple|copy
# Right-click ON an existing highlight -> recolor or delete it.
context_menu_items_for_highlights delete_highlight|edit_selected_highlight|_Yellow|_Green|_Blue|_Pink|_Red|_Orange|_Purple

# ---------- CUSTOM COMMANDS ----------
# NOTE: new_command/new_macro are parsed by the *prefs* config reader, so they
# must live here and not in keys_user.config (where they are silently ignored).
# These two need the python helper: pip install --user sioyek
new_command _add_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"
new_command _add_red_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}" fontsize=5 text_color=255,0,0

# ---------- QUALITY OF LIFE ----------
# Smooth, continuous scrolling instead of jumping between positions.
smooth_scroll_speed 3
smooth_scroll_drag 3000

# Index document text for much faster search + enables regex_search.
super_fast_search 1

# Double-click selects whole words (character-based selection on single click).
single_click_selects_words 0

# Show which document/page you're on and the closest bookmark in the statusbar.
show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
show_close_portal_in_statusbar 1

# Sort bookmarks by their position in the document rather than creation time.
sort_bookmarks_by_location 1

# Auto-generate a table of contents when a PDF doesn't ship with one.
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000

# Middle click / shift+middle click a word to search it externally.
search_url_s https://scholar.google.com/scholar?q=
search_url_g https://www.google.com/search?q=
search_url_d https://duckduckgo.com/?q=
middle_click_search_engine s
shift_middle_click_search_engine g
highlight_middle_click 1

# Zoom towards the mouse cursor instead of the center of the screen.
wheel_zoom_on_cursor 1

# Second color scheme, toggled with toggle_custom_color. Unlike dark mode
# (which inverts), this maps white -> custom_background_color and black ->
# custom_text_color via a color matrix, so images are tinted rather than
# negated. NOTE: these two values are sioyek's stock defaults and are a cool
# slate-blue, not sepia -- effectively a second dark theme. For actual sepia
# try: background 0.92 0.86 0.70 / text 0.24 0.18 0.11
custom_background_color 0.180 0.204 0.251
custom_text_color 0.847 0.871 0.914

# While in presentation mode, pre-render the next page to avoid flicker.
prerender_next_page_presentation 1

# Long menus wrap instead of getting truncated.
multiline_menus 1

# ---------- TEXT-TO-SPEECH ----------
# Speech rate for toggle_reading/start_reading (1.0 = normal speed).
tts_rate 1.0
