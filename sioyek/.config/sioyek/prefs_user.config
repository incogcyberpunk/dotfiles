# ============================================================================
# prefs_user.config - personal sioyek preferences
# Overrides values from the shipped /etc/sioyek/prefs.config (see that file,
# or the `prefs` command inside sioyek, for the full list of defaults).
# ============================================================================

# ---------- STARTUP ----------
# Launch in dark mode and keep using the current window rather than spawning
# a new one every time a file is opened.
startup_commands toggle_dark_mode
should_launch_new_window 1
should_load_tutorial_when_no_other_file 1

# ---------- APPEARANCE ----------
page_separator_width 1
page_separator_color 0.5 0.5 0.5

# Dim pure white text in dark mode so it's easier on the eyes.
dark_mode_contrast 0.85

# Mouse-selection highlight color while dragging (pdf.js default yellow).
text_highlight_color 1.0 1.0 0.596

# ---------- HIGHLIGHT COLORS (pdf.js palette) ----------
# pdf.js's built-in highlight editor ships 5 swatches (see mozilla/pdf.js
# web/app_options.js -> highlightEditorColors): yellow, green, blue, pink, red.
# We remap those letters here and add two bonus colors (orange, purple) since
# sioyek supports 26 highlight types (a-z). Use with `add_highlight` + letter,
# see keys_user.config for the actual keybindings.

# Yellow  (pdf.js #FFFF98)
highlight_color_y 1.00 1.00 0.596
# Green   (pdf.js #53FFBC)
highlight_color_g 0.325 1.00 0.737
# Blue    (pdf.js #80EBFF)
highlight_color_b 0.502 0.922 1.00
# Pink    (pdf.js #FFCBE6)
highlight_color_p 1.00 0.796 0.902
# Red     (pdf.js #FF4F5F)
highlight_color_r 1.00 0.310 0.373
# Orange  (bonus, not in pdf.js default set but common in other PDF tools)
highlight_color_o 1.00 0.659 0.235
# Purple  (bonus)
highlight_color_u 0.761 0.522 1.00

# Freehand drawings reuse the highlight_color_* palette (set_freehand_type
# picks one of these by letter, same as highlight types). Default pen color:
highlight_color_a 1.00 0.310 0.373

# ---------- CUSTOM COMMANDS ----------
# NOTE: new_command/new_macro are parsed by the *prefs* config reader, so they
# must live here and not in keys_user.config (where they are silently ignored).
# These two need the python helper: pip install --user sioyek
new_command _add_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"
new_command _add_red_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}" fontsize=5 text_color=255,0,0

# ---------- QUALITY OF LIFE ----------
# Smooth, continuous scrolling instead of jumping between positions.
smooth_scroll_speed 3
smooth_scroll_drag 3000

# Index document text for much faster search + enables regex_search.
super_fast_search 1

# Double-click selects whole words (character-based selection on single click).
single_click_selects_words 0

# Show which document/page you're on and the closest bookmark in the statusbar.
show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
show_close_portal_in_statusbar 1

# Sort bookmarks by their position in the document rather than creation time.
sort_bookmarks_by_location 1

# Auto-generate a table of contents when a PDF doesn't ship with one.
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000

# Middle click / shift+middle click a word to search it externally.
search_url_s https://scholar.google.com/scholar?q=
search_url_g https://www.google.com/search?q=
search_url_d https://duckduckgo.com/?q=
middle_click_search_engine s
shift_middle_click_search_engine g
highlight_middle_click 1

# Zoom towards the mouse cursor instead of the center of the screen.
wheel_zoom_on_cursor 1

# Custom "reading mode" colors, toggled with toggle_custom_color (fixed
# sepia-like scheme, different from dark mode's color inversion).
custom_background_color 0.180 0.204 0.251
custom_text_color 0.847 0.871 0.914

# While in presentation mode, pre-render the next page to avoid flicker.
prerender_next_page_presentation 1

# Long menus wrap instead of getting truncated.
multiline_menus 1

# ---------- TEXT-TO-SPEECH ----------
# Speech rate for toggle_reading/start_reading (1.0 = normal speed).
tts_rate 1.0
