#Convert hex to rgb
hex2rgb() {
  python3 -c "h='${1#\#}'; print(tuple(int(h[i:i+2],16) for i in (0,2,4)))"
}

#Convert rgb to hex
rgb2hex() {
  python3 -c "print('#%02x%02x%02x' % ($1, $2, $3))"
}

#Search for the installed packages
function spkg(){
    if [[ -z $1 ]]; then
        pacman -Qq | fzf  | xargs -r pacman -Qi
    else
        pacman -Qi $1
    fi
}

function rdir(){
    if [[ -z $1 ]]; then
        fd -d 1 -t d | fzf -m | xargs -or -I {} rm -rIv {}
    else
        rm -rfIv $1
    fi
}

# Search who provides the command in Arch Linux 
pkgwho(){
    pacman -Qo $(which $1)
}

# Find which package provides a file
findpkg(){
    pacman -F $1
}

