#!/usr/bin/env python3
"""Apply safe battery preferences without touching a running browser database."""

from __future__ import annotations

import configparser
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
DRY_RUN = "--dry-run" in sys.argv


def process_running(fragment: str) -> bool:
    result = subprocess.run(
        ["pgrep", "-afi", fragment], capture_output=True, text=True, check=False
    )
    lines = [line for line in result.stdout.splitlines() if "configure-battery-browsers" not in line]
    return bool(lines)


def atomic_json_write(path: Path, data: dict) -> None:
    if DRY_RUN:
        print(f"would update {path}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        backup = path.with_name(path.name + ".pre-battery-profile")
        if not backup.exists():
            shutil.copy2(path, backup)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, separators=(",", ":"))
            handle.write("\n")
        os.chmod(temporary, path.stat().st_mode & 0o777 if path.exists() else 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def configure_zen() -> None:
    profiles_ini = HOME / ".zen/profiles.ini"
    if not profiles_ini.exists():
        print("Zen profile not found; skipping")
        return
    parser = configparser.ConfigParser()
    parser.read(profiles_ini)
    selected: Path | None = None
    for section in parser.sections():
        if not section.startswith("Profile"):
            continue
        values = parser[section]
        if values.get("Default") == "1" or selected is None:
            candidate = Path(values["Path"])
            selected = (profiles_ini.parent / candidate) if values.get("IsRelative", "1") == "1" else candidate
        if values.get("Default") == "1":
            break
    if selected is None:
        print("Zen default profile not found; skipping")
        return

    user_js = selected / "user.js"
    line = 'user_pref("browser.sessionstore.restore_pinned_tabs_on_demand", true);\n'
    existing = user_js.read_text() if user_js.exists() else ""
    if line.strip() in existing:
        print(f"Zen pinned-tab restore already configured in {user_js}")
        return
    if DRY_RUN:
        print(f"would add pinned-tab on-demand restore to {user_js}")
        return
    with user_js.open("a") as handle:
        if existing and not existing.endswith("\n"):
            handle.write("\n")
        handle.write("// Managed by automatic battery profile.\n")
        handle.write(line)
    print(f"Configured Zen profile: {selected}")


def configure_brave() -> None:
    base = HOME / ".config/BraveSoftware/Brave-Browser"
    local_state = base / "Local State"
    preferences = base / "Default/Preferences"
    if not local_state.exists():
        print("Standard Brave profile not found; skipping")
        return
    if process_running(r"/opt/brave-bin/|/opt/brave.com/brave/"):
        print("Standard Brave is running; close it and rerun this command", file=sys.stderr)
        return

    local = json.loads(local_state.read_text())
    performance = local.setdefault("performance_tuning", {})
    memory = performance.setdefault("high_efficiency_mode", {})
    memory["state"] = 2
    memory["aggressiveness"] = 2
    memory["time_before_discard_in_minutes"] = 10
    performance.setdefault("battery_saver_mode", {})["state"] = 2
    local.setdefault("background_mode", {})["enabled"] = False
    local.setdefault("hardware_acceleration_mode", {})["enabled"] = True
    atomic_json_write(local_state, local)

    if preferences.exists():
        prefs = json.loads(preferences.read_text())
        prefs.setdefault("net", {})["network_prediction_options"] = 2
        atomic_json_write(preferences, prefs)
    print("Configured standard Brave for on-battery Energy Saver and aggressive Memory Saver")


def main() -> None:
    configure_zen()
    configure_brave()


if __name__ == "__main__":
    main()
